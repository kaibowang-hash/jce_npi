{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/npi/contracts/integration-event.schema.json",
  "title": "NPI One Integration Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source_system",
    "global_id",
    "object_type",
    "object_version",
    "trace_id",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "npi.ebom_publish_request.ready"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source_system": {
            "const": "NPI_ONE"
          },
          "target_system": {
            "const": "ERPNEXT"
          },
          "object_type": {
            "const": "EngineeringBOMPublishRequest"
          },
          "payload": {
            "$ref": "#/$defs/engineering_bom_publish_request_ready_v1"
          }
        },
        "required": [
          "target_system",
          "payload_hash",
          "actor"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "erpnext.ebom_publish_result.observed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "source_system": {
            "const": "ERPNEXT"
          },
          "target_system": {
            "const": "NPI_ONE"
          },
          "object_type": {
            "const": "EngineeringBOMPublishRequest"
          },
          "payload": {
            "$ref": "#/$defs/engineering_bom_publish_result_observed_v1"
          }
        },
        "required": [
          "target_system",
          "payload_hash",
          "correlation_id",
          "causation_id",
          "actor"
        ]
      }
    }
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "enum": [
        "NPI_ONE",
        "ERPNEXT"
      ]
    },
    "target_system": {
      "enum": [
        "NPI_ONE",
        "ERPNEXT"
      ]
    },
    "global_id": {
      "type": "string",
      "format": "uuid"
    },
    "object_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_object_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "object_version": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "actor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 255
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "payload_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "enum": [
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "internal"
    }
  },
  "$defs": {
    "engineering_bom_publish_request_ready_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "api_version",
        "operation",
        "publish_request_global_id",
        "project_global_id",
        "ebom_global_id",
        "revision_global_id",
        "revision_snapshot_hash",
        "release_event_global_id",
        "release_event_hash",
        "approval_evidence_ids",
        "target_mode",
        "owned_fields",
        "node_input_hashes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "api_version": {
          "const": "npi.erp-publish.v1"
        },
        "operation": {
          "const": "publish_released_ebom_item_mbom"
        },
        "publish_request_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "ebom_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_event_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "release_event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "target_mode": {
          "const": "sandbox"
        },
        "owned_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "engineering_item_id",
              "engineering_description",
              "ebom_hierarchy",
              "engineering_quantity",
              "engineering_uom",
              "alternates",
              "effectivity",
              "engineering_attributes"
            ]
          }
        },
        "node_input_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "engineering_bom_publish_result_observed_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "api_version",
        "operation",
        "publish_request_global_id",
        "request_payload_hash",
        "attempt_id",
        "results"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "api_version": {
          "const": "npi.erp-publish.v1"
        },
        "operation": {
          "const": "publish_released_ebom_item_mbom"
        },
        "publish_request_global_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_global_id",
              "node_input_hash",
              "state",
              "formal_item_code",
              "formal_mbom_id",
              "target_version",
              "fault_kind"
            ],
            "properties": {
              "node_global_id": {
                "type": "string",
                "format": "uuid"
              },
              "node_input_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "enum": [
                  "succeeded",
                  "failed_retryable",
                  "failed_final",
                  "uncertain_after_timeout",
                  "target_unavailable"
                ]
              },
              "formal_item_code": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 140
              },
              "formal_mbom_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 140
              },
              "target_version": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 140
              },
              "fault_kind": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "timeout_after_possible_commit",
                  "rate_limited",
                  "target_server_error",
                  "business_validation",
                  "stale_mapping",
                  "target_unavailable",
                  null
                ]
              }
            }
          }
        }
      }
    }
  }
}
