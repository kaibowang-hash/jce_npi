    {"fieldname": "state", "fieldtype": "Select", "label": "State", "options": "pending\nprocessing\nsucceeded\nfailed_retryable\nfailed_final\nquarantined\nsuperseded\nreceived_after_creation", "reqd": 1, "read_only": 1},
