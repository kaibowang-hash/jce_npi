    {"fieldname": "request_id", "fieldtype": "Data", "label": "Request ID", "read_only": 1},
    {"fieldname": "trace_id", "fieldtype": "Data", "label": "Trace ID", "read_only": 1},
    {"fieldname": "correlation_id", "fieldtype": "Data", "label": "Correlation ID", "read_only": 1},
