    {"fieldname": "event_version", "fieldtype": "Int", "label": "Event Version", "read_only": 1},
    {"fieldname": "target_system", "fieldtype": "Data", "label": "Target System", "read_only": 1},
    {"fieldname": "global_id", "fieldtype": "Data", "label": "Global ID", "read_only": 1},
