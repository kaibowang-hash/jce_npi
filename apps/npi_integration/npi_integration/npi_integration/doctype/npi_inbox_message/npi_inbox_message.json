    {"fieldname": "receipt_snapshot", "fieldtype": "JSON", "label": "Receipt Snapshot", "read_only": 1},
    {"fieldname": "receipt_hash", "fieldtype": "Data", "label": "Receipt Hash", "read_only": 1}
