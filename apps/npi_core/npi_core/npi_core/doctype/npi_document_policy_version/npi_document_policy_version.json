{
  "doctype": "DocType",
  "name": "NPI Document Policy Version",
  "module": "NPI Core",
  "custom": 0,
  "allow_rename": 0,
  "autoname": "field:version_key",
  "track_changes": 1,
  "title_field": "title",
  "search_fields": "policy_key,title,version_key",
  "fields": [
    {"fieldname": "global_id", "fieldtype": "Data", "label": "Global ID", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "document_policy", "fieldtype": "Link", "label": "Document Policy", "options": "NPI Document Policy", "reqd": 1},
    {"fieldname": "tenant_id", "fieldtype": "Data", "label": "Tenant ID", "reqd": 1, "read_only": 1},
    {"fieldname": "policy_global_id", "fieldtype": "Data", "label": "Policy Global ID", "reqd": 1, "read_only": 1},
    {"fieldname": "policy_key", "fieldtype": "Data", "label": "Policy Key", "reqd": 1, "read_only": 1},
    {"fieldname": "policy_version", "fieldtype": "Int", "label": "Policy Version", "reqd": 1},
    {"fieldname": "version_key", "fieldtype": "Data", "label": "Version Key", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1},
    {"fieldname": "publication_state", "fieldtype": "Select", "label": "Publication State", "options": "draft\npublished", "reqd": 1, "default": "draft"},
    {"fieldname": "document_types", "fieldtype": "JSON", "label": "Document Types", "reqd": 1},
    {"fieldname": "confidentiality_keys", "fieldtype": "JSON", "label": "Confidentiality Keys", "reqd": 1},
    {"fieldname": "allowed_mime_types", "fieldtype": "JSON", "label": "Allowed File Formats", "reqd": 1},
