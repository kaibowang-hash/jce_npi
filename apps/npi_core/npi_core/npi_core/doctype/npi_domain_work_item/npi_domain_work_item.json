    {"fieldname": "source_system", "fieldtype": "Select", "label": "Source System", "options": "NPI_ONE", "reqd": 1, "default": "NPI_ONE", "read_only": 1},
    {"fieldname": "optimistic_version", "fieldtype": "Int", "label": "Optimistic Version", "reqd": 1, "default": "1", "read_only": 1}
