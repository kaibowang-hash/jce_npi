    {"fieldname": "reference_rules", "fieldtype": "Table", "label": "Reference Rules", "options": "NPI Template Reference Rule"},
    {"fieldname": "gates", "fieldtype": "Table", "label": "Gate Definitions", "options": "NPI Template Gate Definition", "reqd": 1},
    {"fieldname": "snapshot_hash", "fieldtype": "Data", "label": "Snapshot Hash", "read_only": 1},
    {"fieldname": "published_at", "fieldtype": "Datetime", "label": "Published At", "read_only": 1}
