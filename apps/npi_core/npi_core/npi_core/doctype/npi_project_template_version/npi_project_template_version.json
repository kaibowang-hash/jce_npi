    {"fieldname": "template_global_id", "fieldtype": "Data", "label": "Template Global ID", "reqd": 1, "read_only": 1},
    {"fieldname": "template_code", "fieldtype": "Data", "label": "Template Code", "reqd": 1, "read_only": 1},
    {"fieldname": "template_version", "fieldtype": "Int", "label": "Template Version", "reqd": 1},
    {"fieldname": "version_key", "fieldtype": "Data", "label": "Version Key", "reqd": 1, "unique": 1, "read_only": 1},
