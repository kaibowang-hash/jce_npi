{
  "doctype": "DocType",
  "name": "NPI Gate Review Policy Version",
  "module": "NPI Core",
  "custom": 0,
  "allow_rename": 0,
  "autoname": "field:version_key",
  "track_changes": 1,
  "title_field": "title",
