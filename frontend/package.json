{
  "name": "npi-one-web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "18.20.8",
    "npm": "10.8.2"
  },
  "scripts": {
    "generate:policy-labels": "node scripts/generate-policy-label-sources.mjs",
    "generate:policy-labels:check": "node scripts/generate-policy-label-sources.mjs --check",
    "generate": "npm run generate:policy-labels && node scripts/generate-tokens.mjs && node scripts/build-catalog.mjs",
    "generate:check": "npm run generate:policy-labels:check && node scripts/generate-tokens.mjs --check && node scripts/build-catalog.mjs --check",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint:code": "eslint .",
    "lint:format": "prettier --check .",
    "lint:boundaries": "node scripts/verify-boundaries.mjs",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:ui": "node scripts/verify-ui.mjs",
    "lint:i18n": "node --test scripts/shared.test.mjs && node scripts/verify-i18n.mjs",
    "lint": "npm run lint:code && npm run lint:format && npm run lint:styles && npm run lint:boundaries && npm run lint:ui && npm run lint:i18n",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/normalize-coverage-summary.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=all",
    "test": "npm run test:coverage",
    "audit": "npm audit && npm audit --omit=dev",
    "verify": "npm run generate:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run audit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@siemens/ix": "3.2.0",
    "@siemens/ix-icons": "3.1.1",
    "@siemens/ix-react": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "18.19.130",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.8.2",
    "stylelint": "16.12.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
